run = "flutter run -d web-server --web-hostname 0.0.0.0 --web-port 8080"
entrypoint = "lib/main.dart"

[deployment]
run = ["flutter", "run", "-d", "web-server", "--web-hostname", "0.0.0.0", "--web-port", "8080"]

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Start Flutter Preview"

[[workflows.workflow]]
name = "Start Flutter Preview"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flutter pub get && flutter run -d web-server --web-hostname 0.0.0.0 --web-port 8080"
